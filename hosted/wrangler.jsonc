// SPDX-License-Identifier: AGPL-3.0-only
// blowhorn-mcp-hosted: the interim read-only MCP gateway (see README.md).
// Deployed with `make hosted-deploy` from the VM only. No routes block: the
// mcp.blowhorn.ai custom domain is attached through the Cloudflare API.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blowhorn-mcp-hosted",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CLOUD_API_BASE": "https://cloud.blowhorn.ai",
    "ALLOWED_ORIGINS": ""
  },
  // Invocation logs (Cloudflare's per-request metadata) are off, so Workers
  // Logs holds only the explicit console lines from src/index.js: method,
  // tool name, status and duration.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  }
}
