// SPDX-License-Identifier: Apache-2.0
// blowhorn-mcp-hosted: the interim MCP transport proxy (see README.md).
// Production is the top level of this file: `wrangler deploy` with no --env
// (`make hosted-deploy`). No routes block there: the mcp.blowhorn.ai custom
// domain is attached through the Cloudflare API. env.staging is a second
// Worker, blowhorn-mcp-hosted-staging, on https://mcp-staging.blowhorn.ai in
// front of staging Cloud (`make hosted-deploy-staging`). Both deploy from
// .github/workflows/hosted-deploy.yml on merge to master.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blowhorn-mcp-hosted",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Wrangler's anonymous usage telemetry is off for every deploy from here.
  "send_metrics": false,
  "vars": {
    // The (CLOUD_API_BASE, PUBLIC_ORIGIN) pair must be one of the pairs in
    // schemas/deployments.json, else the Worker refuses to serve. Production
    // is the default pair; PUBLIC_ORIGIN is spelled out so the pair is plain.
    "CLOUD_API_BASE": "https://cloud.blowhorn.ai",
    "PUBLIC_ORIGIN": "https://mcp.blowhorn.ai",
    "ALLOWED_ORIGINS": "",
    // Rate limits (src/ratelimit.js, schemas/rate-limits.schema.json,
    // README.md, Rate limits). JSON, parsed at request time. A refused
    // request answers 429 with Retry-After and blowhorn-mcp-1010, and is
    // never sent to Cloud or recorded. Each limit lives only here (and in
    // README.md's table, which test/ratelimit.test.js holds to it). LIMITS
    // in src/ratelimit.js keeps only each limit's cause. period is 10 or 60
    // seconds. The Durable Object below is the only enforcer: Cloudflare's
    // simple ratelimits bindings do not enforce live
    // (https://github.com/cloudflare/workers-sdk/issues/16097). A missing
    // RATE_LIMITER binding fails closed (503) and logs ratelimit_unbound.
    //
    // caller: keyed by the hex SHA-256 of the bearer token, never the token.
    // Checked once the token and the body parse, before any Cloud call; only
    // tools/call messages count, never initialize, tools/list or ping. 60 per
    // 60 s.
    //
    // address: keyed by CF-Connecting-IP (an IPv6 address by its /64).
    // Checked before anything else on every /mcp and protected resource
    // metadata request; a request it refuses gets no work and no Cloud call. It is the only bound on a
    // client that rotates made-up tokens, since each new token gets its own
    // caller bucket: one address can still send up to its limit a minute of
    // requests that reach Cloud and are refused there with 401. Everyone
    // behind one egress address shares it, so it sits well above the caller
    // limit times the about 4 requests a stateless client sends per tool
    // call, leaving room for several such clients behind one NAT. 1200 per
    // 60 s.
    "RATE_LIMITS": "{\"address\":{\"limit\":1200,\"period\":60},\"caller\":{\"limit\":60,\"period\":60}}"
  },
  // One fixed-window limiter for both keys (src/ratelimit.js, RateLimiter).
  // new_sqlite_classes: the counter is stored in the object's SQLite storage.
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
  ],
  // The staging Worker. wrangler does not inherit vars, durable_objects or
  // migrations into an environment, so each is declared again here. The
  // separate Worker name gives staging its own RateLimiter Durable Object
  // namespace: no rate limit state is shared with production. Staging's
  // limits are production's; test/deployments.test.js holds them equal.
  "env": {
    "staging": {
      "name": "blowhorn-mcp-hosted-staging",
      "workers_dev": false,
      "preview_urls": false,
      // The custom domain is created by the deploy. The CI Cloudflare token
      // needs DNS and Workers Routes edit on the blowhorn.ai zone for that;
      // without it the staging job fails and production is unaffected (the
      // jobs are independent).
      "routes": [
        { "pattern": "mcp-staging.blowhorn.ai", "custom_domain": true }
      ],
      "vars": {
        "CLOUD_API_BASE": "https://staging-cloud.layer5.io",
        "PUBLIC_ORIGIN": "https://mcp-staging.blowhorn.ai",
        "ALLOWED_ORIGINS": "",
        "RATE_LIMITS": "{\"address\":{\"limit\":1200,\"period\":60},\"caller\":{\"limit\":60,\"period\":60}}"
      },
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "invocation_logs": false
        }
      }
    }
  },
  // Invocation logs (Cloudflare's per-request metadata) are off, so Workers
  // Logs holds only the gateway's explicit console lines (README.md, Logs).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  }
}
