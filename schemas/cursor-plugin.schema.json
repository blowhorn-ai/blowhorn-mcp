{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blowhorn-ai/blowhorn-mcp/schemas/cursor-plugin.schema.json",
  "title": "Cursor plugin manifest (.cursor-plugin/plugin.json)",
  "description": "Written from https://cursor.com/docs/reference/plugins; Cursor publishes no JSON Schema of its own.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "name": { "description": "Lowercase kebab-case plugin identifier.", "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "author": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" }
      },
      "required": ["name"]
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string" },
    "license": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "logo": { "$ref": "#/$defs/pluginPath" },
    "skills": { "$ref": "#/$defs/pathOrPaths" },
    "mcpServers": {
      "description": "A path to an MCP config file, or the mcpServers object inline.",
      "oneOf": [{ "$ref": "#/$defs/pluginPath" }, { "type": "object" }]
    }
  },
  "required": ["name"],
  "$defs": {
    "pluginPath": {
      "description": "Relative to the plugin root; never absolute, never through \"..\".",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "pathOrPaths": {
      "oneOf": [{ "$ref": "#/$defs/pluginPath" }, { "type": "array", "items": { "$ref": "#/$defs/pluginPath" } }]
    }
  }
}
