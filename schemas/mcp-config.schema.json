{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blowhorn-ai/blowhorn-mcp/schemas/mcp-config.schema.json",
  "title": "Plugin MCP server config (.mcp.json, mcp.json)",
  "description": "The mcpServers file a Claude Code plugin (.mcp.json) or a Cursor plugin (mcp.json) reads from its root. Ours, because schemas/vendor/agent-plugins-mcp.schema.json requires a $schema member and \"type\": \"stdio\" that neither client's documented form carries.",
  "type": "object",
  "properties": {
    "mcpServers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/stdioServer" }
    }
  },
  "required": ["mcpServers"],
  "additionalProperties": false,
  "$defs": {
    "stdioServer": {
      "type": "object",
      "properties": {
        "type": { "const": "stdio" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "cwd": { "type": "string" }
      },
      "required": ["command"],
      "additionalProperties": false
    }
  }
}
